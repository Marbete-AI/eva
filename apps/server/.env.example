# ── Reasoning Model ──────────────────────────────────────────────────────────
REASONING_MODEL_PROVIDER=anthropic
REASONING_MODEL_NAME=claude-sonnet-4-5

# ── API Keys ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# OpenAI: used for text-embedding-3-small (memory)
OPENAI_API_KEY=
# Google Generative AI (Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=
ELEVENLABS_API_KEY=

# ── ElevenLabs Voice IDs ──────────────────────────────────────────────────────
# Override the default voice per persona. Leave blank to use the hardcoded default.
# Find voice IDs at: https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_COPILOT=2vbhUP8zyKg4dEZaTWGn
ELEVENLABS_VOICE_QUIET_COMPANION=NcJuO1kJ19MefFnxN1Ls
ELEVENLABS_VOICE_MEETING_MODE=oW8bn5YtBB89X2nJ0DT9
# Model: eleven_turbo_v2_5 (default, lowest latency/cost) or eleven_multilingual_v2
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ── SmartCar ──────────────────────────────────────────────────────────────────
SMARTCAR_CLIENT_ID=
SMARTCAR_CLIENT_SECRET=
# Must match exactly what is registered in the SmartCar developer dashboard.
# Register both for dev:
#   http://localhost:8787/smartcar/callback        (iOS simulator)
#   http://192.168.0.159:8787/smartcar/callback    (physical iPhone on LAN)
SMARTCAR_REDIRECT_URI=http://192.168.0.159:8787/smartcar/callback
# simulated — uses SmartCar sandbox virtual vehicles (no real car needed)
# live      — uses real connected vehicles
SMARTCAR_MODE=simulated

# ── Google Maps / OpenWeather ─────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
OPENWEATHER_API_KEY=

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── ADAS Mock Server ──────────────────────────────────────────────────────────
ADAS_MOCK_WS_URL=ws://localhost:3001

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development
