{
  "name": "@eva/adas-mock",
  "version": "0.0.1",
  "private": true,
  "description": "Mock ADAS signal server — emits raw VSS signals over WebSocket. No event labels.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "adas-mock": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --watch dist/cli.js",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ../../node_modules/.bin/jest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@eva/types": "workspace:*",
    "ws": "^8.18.0",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.7.2"
  }
}
